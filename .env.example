# Configurações do Web Scraper
# Copie este arquivo para .env e customize conforme necessário

# Taxa de requisições por segundo (padrão: 2.0)
# Valores menores são mais respeitosos com o servidor
REQUESTS_PER_SECOND=2.0

# Timeout em segundos para cada requisição (padrão: 10)
# Aumentar se os sites demorarem mais para responder
TIMEOUT=10

# Máximo de tentativas para cada URL (padrão: 3)
# Número de vezes que o scraper tentará novamente em caso de erro
MAX_RETRIES=3

# Nível de log (DEBUG, INFO, WARNING, ERROR)
# DEBUG: Muito detalhado
# INFO: Informações gerais (recomendado)
# WARNING: Apenas avisos e erros
# ERROR: Apenas erros
LOG_LEVEL=INFO

# Diretório de saída para os resultados (padrão: diretório atual)
# Deixe vazio para usar o diretório atual
OUTPUT_DIR=

# User-Agent customizado (deixe vazio para usar o padrão)
# USER_AGENT=
